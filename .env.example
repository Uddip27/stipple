# PhotoQR.io checkout configuration
# Copy to .env, fill in the providers you want, then run:
#   node --env-file=.env server.js
# On Vercel, add the same variables under Project Settings → Environment Variables.
# Checkout stays "coming soon" until at least one provider is configured.

# Signs license codes after a verified payment. Required for unlocking.
# Generate any long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
LICENSE_SECRET=

# --- Stripe (cards, Apple Pay, Google Pay) ---
STRIPE_SECRET_KEY=

# --- Lemon Squeezy (cards, PayPal) ---
# Create one product with a variant per plan + billing cycle, then paste each variant ID.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_BUSINESS_MONTHLY=
LEMONSQUEEZY_VARIANT_BUSINESS_YEARLY=
LEMONSQUEEZY_VARIANT_LIFETIME=

# --- Razorpay (UPI, cards, netbanking — INR only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Dodo Payments (cards, local methods) ---
# Use https://test.dodopayments.com while testing.
# Create one product per plan. For exact regional pricing on the Lifetime Pass,
# make it a pay-what-you-want one-time product; subscription products charge their stored price.
DODO_API_KEY=
DODO_API_BASE=https://live.dodopayments.com
DODO_PRODUCT_PRO=
DODO_PRODUCT_BUSINESS=
DODO_PRODUCT_LIFETIME=